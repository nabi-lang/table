//! Column-oriented tables. A `Table` is named, ordered `Column`s of one
//! length; each column is one typed `List` (i64, f64, bool, str,
//! dictionary-encoded str, date, datetime) plus a validity bitmap for
//! nulls. Operations run a column at a time; grouping and joins hash
//! rows into integer keys first (`keys`), so no per-row allocation.

pub mod arrow;
pub mod build;
pub mod column;
