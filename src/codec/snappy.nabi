// Snappy, the raw format Parquet uses (no framing): a varint length,
// then literals and back-references. The compressor is the reference
// greedy one: 64 KiB fragments, a 2^14-entry hash of four-byte groups,
// and a skip that speeds through data that does not compress.

use pkg::TableError;
use pkg::bytes::bad;

const FMT: str = "snappy";
const FRAG: usize = 65536;
const HBITS: u32 = 14;

fn fail(msg: str) -> TableError { bad(FMT, msg) }

/// `b[s..e]` decompressed.
pub(pkg) fn decompress(b: List<u8>, s: usize, e: usize) throws (TableError) -> List<u8> {
    let p = s;
    let n = 0u64;
    let shift = 0u64;
    loop {
        if p >= e || shift > 28u64 { throw fail("the length header is cut short or too long"); }
        let c = b[p] as u64;
        p += 1;
        n = n | ((c & 127u64) << shift);
        if c < 128u64 { break; }
        shift += 7u64;
    }
    let n = n as usize;
    let out: List<u8> = List::with_capacity(n);
    while p < e {
        let tag = b[p] as usize;
        p += 1;
        let kind = tag & 3;
        if kind == 0 {
            let len = (tag >> 2) + 1;
            if len > 60 {
                let k = len - 60;
                if p + k > e { throw fail("a literal length is cut short"); }
                len = 0;
                for i in 0..k {
                    len = len | ((b[p + i] as usize) << (8 * i));
                }
                len += 1;
                p += k;
            }
            if len > e - p || out.len() + len > n { throw fail("a literal runs past the end"); }
            for i in p..p + len {
                out.push(b[i]);
            }
            p += len;
            continue;
        }
        let len = 0usize;
        let off = 0usize;
        if kind == 1 {
            if p >= e { throw fail("a copy is cut short"); }
            len = 4 + ((tag >> 2) & 7);
            off = ((tag >> 5) << 8) | b[p] as usize;
            p += 1;
        } else if kind == 2 {
            if p + 2 > e { throw fail("a copy is cut short"); }
            len = (tag >> 2) + 1;
            off = b[p] as usize | ((b[p + 1] as usize) << 8);
            p += 2;
        } else {
            if p + 4 > e { throw fail("a copy is cut short"); }
            len = (tag >> 2) + 1;
            off = b[p] as usize | ((b[p + 1] as usize) << 8) | ((b[p + 2] as usize) << 16) | ((b[p + 3] as usize) << 24);
            p += 4;
        }
        if off == 0 || off > out.len() || out.len() + len > n { throw fail("a copy points before the start or runs past the end"); }
        // Byte by byte: the source may overlap what is being written.
        let from = out.len() - off;
        for i in 0..len {
            out.push(out[from + i]);
        }
    }
    if out.len() != n { throw fail(f"the data holds {out.len()} bytes, not the {n} its header says"); }
    out
}

fn load(b: List<u8>, i: usize) -> u32 {
    (b[i] as u32) | ((b[i + 1] as u32) << 8u32) | ((b[i + 2] as u32) << 16u32) | ((b[i + 3] as u32) << 24u32)
}

fn hash(x: u32) -> usize { (x.wrapping_mul(0x1E35A7BDu32) >> (32u32 - HBITS)) as usize }

fn literal(out: List<u8>, b: List<u8>, s: usize, e: usize) {
    let n = e - s;
    if n == 0 { return; }
    let m = n - 1;
    if m < 60 {
        out.push((m << 2) as u8);
    } else if m < 256 {
        out.push((60 << 2) as u8);
        out.push(m as u8);
    } else if m < 65536 {
        out.push((61 << 2) as u8);
        out.push(m as u8);
        out.push((m >> 8) as u8);
    } else {
        out.push((63 << 2) as u8);
        out.push(m as u8);
        out.push((m >> 8) as u8);
        out.push((m >> 16) as u8);
        out.push((m >> 24) as u8);
    }
    for i in s..e {
        out.push(b[i]);
    }
}

fn copy(out: List<u8>, off: usize, len: usize) {
    let n = len;
    while n >= 68 {
        copy2(out, off, 64);
        n -= 64;
    }
    if n > 64 {
        copy2(out, off, 60);
        n -= 60;
    }
    if n < 12 && off < 2048 {
        out.push((1 + ((n - 4) << 2) + ((off >> 8) << 5)) as u8);
        out.push(off as u8);
    } else {
        copy2(out, off, n);
    }
}

fn copy2(out: List<u8>, off: usize, n: usize) {
    out.push((2 + ((n - 1) << 2)) as u8);
    out.push(off as u8);
    out.push((off >> 8) as u8);
}

/// `b[s..e]` compressed.
pub(pkg) fn compress(b: List<u8>, s: usize, e: usize) -> List<u8> {
    let out: List<u8> = List::with_capacity((e - s) / 2 + 16);
    let n = e - s;
    loop {
        out.push(if n >= 128 { (n & 127 | 128) as u8 } else { n as u8 });
        if n < 128 { break; }
        n = n >> 7;
    }
    let table: List<i64> = List::filled(1 << 14, -1);
    let f = s;
    while f < e {
        let fe = (f + FRAG).min(e);
        for k in 0..table.len() {
            table[k] = -1;
        }
        let emit = f;
        let i = f;
        let skip = 32usize;
        while i + 4 <= fe {
            let x = load(b, i);
            let h = hash(x);
            let c = table[h];
            table[h] = i as i64;
            if c >= 0 && load(b, c as usize) == x {
                let c = c as usize;
                literal(out, b, emit, i);
                let len = 4usize;
                while i + len < fe && b[c + len] == b[i + len] {
                    len += 1;
                }
                copy(out, i - c, len);
                i += len;
                emit = i;
                skip = 32;
            } else {
                i += skip >> 5;
                skip += 1;
            }
        }
        literal(out, b, emit, fe);
        f = fe;
    }
    out
}
