Package {
    name: "table",
    version: "0.1.0",
    nabi_version: "0.1.0",
    toolchain: "0.1",
    description: "Column-oriented tables: typed columns with nulls, CSV, JSON lines, Arrow IPC and Parquet I/O, expressions, group-by, joins, reshaping, lazy queries",
    license: "MIT OR Apache-2.0",
    repository: "https://github.com/nabi-lang/table",
    keywords: ["dataframe", "table", "csv", "parquet", "arrow"],
    categories: ["science", "data-structures", "parser-implementations"],
    deps: {
        "csvio": Dep::path("../csv", version: "^0.1", package: "csv"),
        "json": Dep::path("../json", version: "^0.1"),
    },
    dev_deps: {
        "plot": Dep::path("../plot", version: "^0.1"),
        // `stats` would clash with the module of that name.
        "stats_pkg": Dep::path("../stats", version: "^0.1", package: "stats"),
    },
}
